          { "label": "Sonos Cloud Client Secret optional" },
          { "label": "OAuth Redirect Basis URL optional" }
        ],
        "translation_outputs": [
          { "label": "Admin Listener Port" },
          { "label": "Player im Register" },
          { "label": "Presets im Register" },
          { "label": "Gruppen-Presets im Register" },
          { "label": "Cloud OAuth autorisiert" },
          { "label": "Letztes Suchergebnis ip;uuid;modell pro Zeile" },
          { "label": "Letzte Suche Anzahl" },
          { "label": "Letzter Fehler" }
