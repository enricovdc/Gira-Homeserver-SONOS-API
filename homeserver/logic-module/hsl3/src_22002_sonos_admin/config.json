{
  "module": {
    "id": "22002",
    "context": "sonos.bridge",
    "category": "Multimedia\\Sonos",
    "name": "Sonos Admin",
    "version": "1.0.0",
    "hsl_filename": "22002_sonos_admin.hsl",
    "inputs": [
      { "type": "number", "identifier": "HttpPort",             "init_value": 8080, "label": "Admin HTTP Port" },
      { "type": "number", "identifier": "AutoDiscoverInterval", "init_value": 300,  "label": "Auto Discover Interval seconds" },
      { "type": "number", "identifier": "TriggerDiscovery",     "init_value": 0,    "label": "Trigger Discovery Now" },
      { "type": "string", "identifier": "CloudClientId",        "init_value": "",   "label": "Sonos Cloud Client ID optional" },
      { "type": "string", "identifier": "CloudClientSecret",    "init_value": "",   "label": "Sonos Cloud Client Secret optional" },
      { "type": "string", "identifier": "OAuthRedirectBase",    "init_value": "",   "label": "OAuth Redirect Base URL optional" }
    ],
    "outputs": [
      { "type": "number", "identifier": "ListenPort",       "init_value": 0,  "label": "Admin Listener Port" },
      { "type": "number", "identifier": "PlayerCount",      "init_value": 0,  "label": "Players in Registry" },
      { "type": "number", "identifier": "StationCount",     "init_value": 0,  "label": "Stations in Registry" },
      { "type": "number", "identifier": "CloudAuthorized",  "init_value": 0,  "label": "Cloud OAuth Authorized" },
      { "type": "string", "identifier": "LastError",        "init_value": "", "label": "Last Error" }
    ],
    "store": [
